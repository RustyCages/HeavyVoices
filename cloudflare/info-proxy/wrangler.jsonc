{
  // Separat Worker för info.heavyvoices.se. Deploy: `npx wrangler deploy` i den här mappen,
  // eller i Cloudflare-panelen (se README.md här bredvid).
  "name": "heavy-voices-info",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "services": [{ "binding": "SITE", "service": "heavy-voices" }],
  "routes": [{ "pattern": "info.heavyvoices.se", "custom_domain": true }],
  "workers_dev": false
}
